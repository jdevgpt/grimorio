rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Partidas: cualquiera con sesión puede buscar por código; solo el DM las gestiona.
    match /partidas/{pid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.dm == request.auth.uid
        && request.resource.data.miembros == [request.auth.uid];
      allow delete: if request.auth != null && resource.data.dm == request.auth.uid;
      allow update: if request.auth != null && (
        // El DM puede cambiar todo menos quién es el DM
        (resource.data.dm == request.auth.uid && request.resource.data.dm == resource.data.dm)
        // Un jugador solo puede añadirse o quitarse a sí mismo de la lista de miembros
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros'])
            && (request.resource.data.miembros.toSet() == resource.data.miembros.toSet().union([request.auth.uid].toSet())
                || request.resource.data.miembros.toSet() == resource.data.miembros.toSet().difference([request.auth.uid].toSet())))
      );
    }

    // Personajes: cada jugador escribe solo los suyos; los lee él y el DM de su partida.
    match /personajes/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.lectores;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.lectores
        && request.resource.data.lectores.size() <= 2;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.lectores.size() <= 2;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
